    <PackageReference Include="Microsoft.TeamFoundationServer.ExtendedClient" />
    <PackageReference Include="Polly" />
    <PackageReference Include="Polly.Core" />
    <PackageReference Include="Polly.RateLimiting" />
    <PackageReference Include="ExceptionFactories" />
    <PackageReference Include="CommonModels" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IOOperation.BaseUtilityServices\IOOperation.BaseUtilityServices.csproj" />
    <ProjectReference Include="..\TaskUtilityServices\TaskUtilityServices.csproj" />
  </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Attachments\" />
    </ItemGroup>
</Project>
